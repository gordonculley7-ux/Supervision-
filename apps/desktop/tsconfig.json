{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@core": ["../../packages/core/src/index.ts"],
      "@data-adapter": ["../../packages/data/src/adapter.ts"]
    }
  },
  "include": ["src"]
}
