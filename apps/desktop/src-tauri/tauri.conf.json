{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Supervision & CEU Tracker",
  "version": "0.1.0",
  "identifier": "com.supervisiontracker.lite",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Supervision & CEU Tracker — Lite",
        "label": "main",
        "width": 1040,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "copyright": "© 2026 Gordon Culley",
    "category": "Productivity",
    "shortDescription": "Track supervision hours and CEUs.",
    "longDescription": "Offline tracker of supervised hours and continuing education for LPCC, LGSW, LMFT, and LADC clinicians."
  }
}
